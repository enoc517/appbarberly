rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if isSelf(userId);
      allow delete: if false;

      match /favorites/{barbershopId} {
        allow read, write: if isSelf(userId);
      }
    }

    match /barbershops/{shopId} {
      allow read, write: if signedIn();

      match /{document=**} {
        allow read, write: if signedIn();
      }
    }

    match /bookings/{bookingId} {
      allow read, write: if signedIn();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if signedIn();
      allow update: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow delete: if false;
    }

    match /penalties/{penaltyId} {
      allow read, write: if signedIn();
    }

    match /phone_numbers/{phone} {
      allow read, write: if signedIn();
    }

    match /professional_requests/{requestId} {
      allow read, write: if signedIn();
    }

    match /services_explore/{serviceId} {
      allow read, write: if signedIn();
    }
  }
}
